# ---------- Backend ----------
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://jit:jit@postgres:5432/jit
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-in-production
JWT_EXPIRES_MINUTES=60
DEMO_MODE=true

# ---------- OPA ----------
OPA_URL=http://opa:8181/v1/data/jit/allow

# ---------- Vault / AWS STS ----------
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root-token
AWS_REGION=us-east-1
# In DEMO_MODE, the mock issuer is used; these are ignored.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000