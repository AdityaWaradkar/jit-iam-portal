# ---------- Application ----------
APP_ENV=development
DEBUG=true
DEMO_MODE=true

# ---------- Ports (host side) ----------
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
OPA_PORT=8181

# ---------- Postgres ----------
POSTGRES_USER=jit
POSTGRES_PASSWORD=jit
